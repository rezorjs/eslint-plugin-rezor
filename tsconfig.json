{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["estree.d.ts", "src", "__tests__"]
}
