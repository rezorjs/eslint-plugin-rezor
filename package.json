{
  "name": "eslint-plugin-rezor",
  "version": "0.2.0",
  "type": "module",
  "description": "ESLint rules for Rezor",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": "https://github.com/rezorjs/eslint-plugin-rezor.git",
  "author": "Yang Mingshan <y.mingshan3@gmail.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier --check \"**/*.{js,ts,json,md}\"",
    "lint": "eslint .",
    "type": "tsc --noEmit",
    "test": "node --test __tests__/*.spec.ts",
    "build": "rm -rf dist && tsc --declaration --project tsconfig.build.json",
    "prepare": "husky"
  },
  "keywords": [
    "eslint",
    "oxlint",
    "plugin",
    "rezor"
  ],
  "dependencies": {
    "@oxlint/plugins": "^1.81.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/estree": "^1.0.9",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
